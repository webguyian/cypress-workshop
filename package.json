{
  "name": "cypress-workshop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "coverage:report": "nyc report --reporter=html --reporter=text --reporter=text-summary --report-dir=coverage",
    "precoverage:full": "rm -rf .nyc_output coverage",
    "coverage:full": "npm run test:all && npm run coverage:report",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "dev": "vite",
    "lint:eslint": "eslint src/ -ext .tsx,.ts --fix --max-warnings=0",
    "lint:ts": "tsc --noEmit",
    "lint": "npm run lint:eslint && npm run lint:ts",
    "preview": "vite preview",
    "start": "npm run dev",
    "test:all": "npm run test:component && npm run test:e2e",
    "test:e2e": "start-server-and-test dev http://localhost:3000 cypress:run",
    "test:component": "cypress run --component"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "react": "^18.3.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.2.4"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^23.2.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@cypress-audit/lighthouse": "^1.4.2",
    "@cypress/code-coverage": "^3.14.7",
    "@eslint/js": "^9.39.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/cypress": "^10.1.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "cypress": "^15.8.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "patch-package": "^8.0.1",
    "start-server-and-test": "^2.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^6.2.0",
    "vite-plugin-istanbul": "^7.2.1"
  }
}
